# .env 文件 - FileFlow Bridge 环境变量配置
# 将此文件复制为 .env 并根据需要自定义

# HTTP 服务端口
FFB_HTTP_PORT=8001

# TCP 服务端口
FFB_TCP_PORT=8888

# 最大文件大小限制 (单位: GiB)
FFB_MAX_FILE_SIZE=100

# 认证令牌长度 (6-32 字符)
FFB_TOKEN_LEN=8

# 日志级别 (DEBUG, INFO, WARN, ERROR)
FFB_LOG_LEVEL=INFO

# 日志文件路径
FFB_LOG_PATH=/var/log/fileflow_bridge.log

# TLS：同时提供证书与私钥即启用 HTTPS（变量名必须与程序读取的一致）
FFB_TLS_CERT=
FFB_TLS_KEY=